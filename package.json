{
  "name": "game-data-center",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "node --import tsx src/migrate.ts",
    "migrate:prod": "node dist/src/migrate.js",
    "create-admin": "node --import tsx scripts/create-admin.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.5",
    "ajv": "^8.20.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
