PORT=8080
HOST=0.0.0.0
# 浏览器游戏允许跨域访问客户端 API 的精确来源，多个来源使用英文逗号分隔；不要使用 *。
# CLIENT_CORS_ORIGINS=http://localhost:7456,https://preview.example.com
# 本地开发默认使用嵌入式 PGlite，无需安装或启动 PostgreSQL。
PGLITE_DATA_DIR=.data/game-center
# 正式环境设置此项后会自动切换到外部 PostgreSQL：
# DATABASE_URL=postgres://game_admin:replace-with-url-encoded-password@127.0.0.1:5432/game_center
# Docker Compose 还需要设置与 DATABASE_URL 中密码一致的数据库密码：
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
# 本地开发可以保留此值；生产环境启动时会拒绝示例值。
JWT_SECRET=development-only-secret-change-me
# 可选：仅在数据库中不存在该账号时创建一次临时管理员；首次登录必须修改密码。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-temporary-password
TRUST_PROXY=false
BODY_LIMIT=1048576
ARCHIVE_SIZE_LIMIT=262144
# 多副本部署改为 database；单实例保留 memory 可减少一次数据库访问。
RATE_LIMIT_STORE=memory
METRICS_FLUSH_MS=1000
METRICS_MAX_QUEUE=10000
# 0 表示永久保留审计；大于 0 时每日清理更早记录。
AUDIT_RETENTION_DAYS=0
# 下面三项同样使用天数，0 表示永久保留。
EVENT_RETENTION_DAYS=0
ARCHIVE_HISTORY_RETENTION_DAYS=0
CONFIG_HISTORY_RETENTION_DAYS=0
# 加密后台保存的项目级平台凭证；至少 32 位，部署后必须稳定保存和备份。
# CREDENTIAL_ENCRYPTION_KEY=replace-with-random-secret-at-least-32-characters
# 其他平台或集中身份系统可继续使用 Webhook Adapter。
# PLATFORM_IDENTITY_WEBHOOK_URL=https://identity.example.com/verify
# PLATFORM_IDENTITY_WEBHOOK_SECRET=replace-with-shared-secret
