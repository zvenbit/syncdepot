PORT=8080
HOST=0.0.0.0
# 本地开发默认使用嵌入式 PGlite，无需安装或启动 PostgreSQL。
PGLITE_DATA_DIR=.data/game-center
# 正式环境设置此项后会自动切换到外部 PostgreSQL：
# DATABASE_URL=postgres://game_admin:change_me@127.0.0.1:5432/game_center
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production
TRUST_PROXY=false
BODY_LIMIT=1048576
ARCHIVE_SIZE_LIMIT=262144
# 多副本部署改为 database；单实例保留 memory 可减少一次数据库访问。
RATE_LIMIT_STORE=memory
METRICS_FLUSH_MS=1000
# 0 表示永久保留审计；大于 0 时每日清理更早记录。
AUDIT_RETENTION_DAYS=0
# 公开客户端的平台登录凭证由该可信身份服务验证。
# PLATFORM_IDENTITY_WEBHOOK_URL=https://identity.example.com/verify
# PLATFORM_IDENTITY_WEBHOOK_SECRET=replace-with-shared-secret
